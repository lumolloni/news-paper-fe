# Leave empty to use the Vite dev proxy (recommended for local dev):
# requests to /api and /uploads are proxied to http://localhost:1337.
# Set this only if you want the frontend to call Strapi directly (and enable CORS there).
VITE_STRAPI_URL=

# Optional: Strapi API token if you lock down the public read endpoints.
VITE_STRAPI_API_TOKEN=

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Leave blank to disable analytics entirely.
VITE_GA_ID=

# Public site origin (e.g. https://meridian.example) used for canonical URLs,
# Open Graph og:url and JSON-LD. Falls back to the browser origin when blank.
VITE_SITE_URL=
